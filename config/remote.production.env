# Public values of production: madar (oprkvdjudjxxhvodkzgs, eu-central-1). Every page holds them, so none is a secret.
# scripts/build-remote.ts exports them before Vite starts (npm run build:remote -- production). Secrets go in secrets/production.env.
# No VITE_API_URL here: scripts/build-remote.ts takes it from config/server-host.json (the page's own /api on the Worker host,
# the Supabase api function otherwise). The screens add ?forceFunctionRegion=eu-central-1 to a Supabase function URL only.
VITE_SUPABASE_URL=https://oprkvdjudjxxhvodkzgs.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XQ9tnMNzwtktqgRuv26ouQ_wgGKZjvb
VITE_VAPID_PUBLIC_KEY=BDh4pjwIUNX1_W9NRsx956ypO_oLjnKt9Xk0vY0HOVj8XwxW14O5D923ejzE_9fV2Z-SGWTKaCPaidr3MWlE0zQ
# The Satellite button of the maps (owner, 2026-10-20). The Esri key is the Pages secret ESRI_KEY, never here.
VITE_MADAR_SATELLITE=on
