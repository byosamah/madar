# The security headers of the real screens on Cloudflare Pages (plan 5.9; platform facts 9.3).
# scripts/deploy/pages.sh writes dist/_headers from this file, with the hosts of one deployment, after the remote build.
# The prototype build never gets this file (scripts/check-bundles.ts). Lines that start with # stay out of dist/_headers.
#
# Placeholders (scripts/deploy/headers.ts):
#   {{SUPABASE}}      https://<ref>.supabase.co: Auth, Realtime, Storage uploads and the functions
#   {{SUPABASE_WSS}}  wss://<ref>.supabase.co: the Realtime socket
#   {{FILES}}         the host of the signed file links: the Supabase host while MADAR_FILE_STORE is supabase
#                     (proof Z0a, item 6), https://<account>.eu.r2.cloudflarestorage.com after the move to R2
# The fixed host https://nominatim.openstreetmap.org in connect-src is the place search of the pin picker (Task 12b, fbk_017).
# The fixed host https://tiles.openfreemap.org in connect-src is the street map: the tiles and the glyphs (owner, 2026-10-19). It is free,
# with no account and no key. 'wasm-unsafe-eval' in script-src lets the Arabic text plugin of the map run its WebAssembly. It allows no eval().
# style-src keeps 'unsafe-inline', because vaul adds a <style> element. img-src keeps blob: for the pictures of a new upload.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {{FILES}}; font-src 'self' data:; connect-src 'self' {{SUPABASE}} {{SUPABASE_WSS}} {{FILES}} https://nominatim.openstreetmap.org https://tiles.openfreemap.org; frame-src {{FILES}}; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker of browser push (public/sw.js). The browser checks it for a new version on its own; no-cache makes it ask the
# server every time, so a fixed worker reaches the phones at once. The scope is the root, so the worker needs no extra header.
/sw.js
  Cache-Control: no-cache
