# Public values of the test deployment: madar-test (qdgwpnesxppnqsaabqzd, eu-central-1). Every page holds them, so none is a secret.
# scripts/build-remote.ts exports them before Vite starts (npm run build:remote -- test). Secrets go in secrets/test.env.
# No VITE_API_URL here: scripts/build-remote.ts takes it from config/server-host.json (the page's own /api on the Worker host,
# the Supabase api function otherwise). The screens add ?forceFunctionRegion=eu-central-1 to a Supabase function URL only.
VITE_SUPABASE_URL=https://qdgwpnesxppnqsaabqzd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kfY3EbMbn4RfWcDMNo6LVw_pj6G71ZI
VITE_VAPID_PUBLIC_KEY=BLxIb_fqWkvZY23IDrJosqhcgOByqRWQ3itBNXMw8q5BNm2uWH_64LIozAlryETpw86prnocRs7UedNw3ZK1Fac
# The Satellite button of the maps (owner, 2026-10-20). The Esri key is the Pages secret ESRI_KEY, never here.
VITE_MADAR_SATELLITE=on
# The public project token of PostHog Cloud EU (insight design 2026-10-25). It is public by design; no secret.
VITE_POSTHOG_KEY=phc_z2zdLquXcwDB5HtVzcui5gWamjjdjQyWSdD27Kjwje7w
