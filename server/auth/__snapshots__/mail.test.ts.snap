<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0;padding:24px;background:#ffffff;color:#1d1d1f;font-family:-apple-system,'Segoe UI',Tahoma,Arial,sans-serif;text-align:left">
<div dir="ltr" style="text-align:left">
