exports[`renderMail > renders invite in English, and in Arabic with a female actor and reader 1`] = `
{
  "html": "<!doctype html>
<html lang="en" dir="ltr">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Huda invited you to Madar</title></head>
<body style="margin:0;padding:0;background:#ffffff;color:#1c1b19;">
<div dir="ltr" style="max-width:560px;margin:0 auto;padding:32px 24px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif;font-size:16px;line-height:1.6;text-align:left;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 24px;"><tr><td style="padding:0;padding-right:10px;vertical-align:middle;"><img src="https://madar.example/icons/madar-192.png" width="28" height="28" alt="" style="display:block;border:0;outline:none;width:28px;height:28px;"></td><td style="padding:0;vertical-align:middle;font-weight:600;font-size:18px;">Madar</td></tr></table>
<p style="margin:0 0 16px;">Hello Sara,</p>
<p style="margin:0 0 16px;">Huda added you to the office on Madar.</p>
<p style="margin:0 0 16px;">Set your password to sign in.</p>
<p style="margin:0 0 16px;">If the link no longer works, open it and press Send me a new link.</p>
<p style="margin:24px 0;"><a href="https://madar.example/welcome?token_hash=abc&amp;type=invite" style="display:inline-block;padding:12px 20px;background:#1c1b19;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;">Set your password</a></p>
<p style="margin:0 0 16px;font-size:14px;color:#5f5c55;margin-bottom:4px;">If the button does not work, copy this link into your browser:</p>
<p style="margin:0 0 24px;font-size:14px;word-break:break-all;" dir="ltr"><a href="https://madar.example/welcome?token_hash=abc&amp;type=invite" style="color:#1c1b19;">https://madar.example/welcome?token_hash=abc&amp;type=invite</a></p>
<p style="margin:0 0 16px;font-size:13px;color:#5f5c55;border-top:1px solid #e6e3dc;padding-top:16px;">Madar sent this email. Do not reply to it.</p>
</div>
</body>
</html>",
  "subject": "Huda invited you to Madar",
  "text": "Hello Sara,

Huda added you to the office on Madar.

Set your password to sign in.

If the link no longer works, open it and press Send me a new link.

Set your password: https://madar.example/welcome?token_hash=abc&type=invite

Madar sent this email. Do not reply to it.
",
}
`;

exports[`renderMail > renders invite in English, and in Arabic with a female actor and reader 2`] = `
{
  "html": "<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Huda دعتك إلى مدار</title></head>
<body style="margin:0;padding:0;background:#ffffff;color:#1c1b19;">
<div dir="rtl" style="max-width:560px;margin:0 auto;padding:32px 24px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif;font-size:16px;line-height:1.6;text-align:right;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 24px;"><tr><td style="padding:0;padding-left:10px;vertical-align:middle;"><img src="https://madar.example/icons/madar-192.png" width="28" height="28" alt="" style="display:block;border:0;outline:none;width:28px;height:28px;"></td><td style="padding:0;vertical-align:middle;font-weight:600;font-size:18px;">مدار</td></tr></table>
<p style="margin:0 0 16px;">مرحبًا Sara،</p>
<p style="margin:0 0 16px;">أضافتك Huda إلى المكتب في مدار.</p>
<p style="margin:0 0 16px;">عيّني كلمة المرور لتسجيل الدخول.</p>
<p style="margin:0 0 16px;">إذا توقف الرابط عن العمل، افتحيه واضغطي «أرسل لي رابطًا جديدًا».</p>
<p style="margin:24px 0;"><a href="https://madar.example/welcome?token_hash=abc&amp;type=invite" style="display:inline-block;padding:12px 20px;background:#1c1b19;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;">عيّن كلمة المرور</a></p>
<p style="margin:0 0 16px;font-size:14px;color:#5f5c55;margin-bottom:4px;">إذا لم يعمل الزر، انسخي هذا الرابط في المتصفح:</p>
<p style="margin:0 0 24px;font-size:14px;word-break:break-all;" dir="ltr"><a href="https://madar.example/welcome?token_hash=abc&amp;type=invite" style="color:#1c1b19;">https://madar.example/welcome?token_hash=abc&amp;type=invite</a></p>
<p style="margin:0 0 16px;font-size:13px;color:#5f5c55;border-top:1px solid #e6e3dc;padding-top:16px;">أرسل مدار هذه الرسالة. لا تردي عليها.</p>
</div>
</body>
</html>",
  "subject": "Huda دعتك إلى مدار",
  "text": "مرحبًا Sara،

أضافتك Huda إلى المكتب في مدار.

عيّني كلمة المرور لتسجيل الدخول.

إذا توقف الرابط عن العمل، افتحيه واضغطي «أرسل لي رابطًا جديدًا».

عيّن كلمة المرور: https://madar.example/welcome?token_hash=abc&type=invite

أرسل مدار هذه الرسالة. لا تردي عليها.
",
}
`;

